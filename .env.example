# Groq API Key (required for LangGraph agents)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Credentials (PostgreSQL & Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=workplace-safetywatch
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Email / SMTP Settings (To send REAL alert emails to your Gmail inbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_gmail@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,https://workplace-safetywatch.vercel.app

# Frontend Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
